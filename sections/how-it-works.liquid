<section class="how-it-works" id="how-it-works">
  <div class="hiw-inner">
    <div class="section-header reveal-up">
      <div class="section-label">— Setup in seconds</div>
      <h2 class="section-heading">How It Works</h2>
      <p class="section-body">No tools. No stress. Even the cat can figure it out.</p>
    </div>

    <div class="steps-container">
      <div class="steps-line">
        <div class="steps-line-fill" id="steps-line-fill"></div>
      </div>

      <!-- Step 1 -->
      <div class="step reveal-step" data-step="1">
        <div class="step-icon-wrap">
          <div class="step-number">01</div>
          <div class="step-icon">
            <svg viewBox="0 0 80 80" fill="none">
              <circle cx="40" cy="40" r="38" fill="#F5E6D3" stroke="#E8924A" stroke-width="2"/>
              <!-- Desk clip animation target -->
              <rect x="12" y="28" width="56" height="10" rx="3" fill="#8B6340"/>
              <rect x="28" y="18" width="24" height="12" rx="3" fill="#A07850"/>
              <!-- Arrows showing attachment -->
              <path d="M24 44 L24 56" stroke="#E8924A" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="4,3"/>
              <path d="M56 44 L56 56" stroke="#E8924A" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="4,3"/>
              <polygon points="24,60 20,52 28,52" fill="#E8924A"/>
              <polygon points="56,60 52,52 60,52" fill="#E8924A"/>
            </svg>
          </div>
        </div>
        <div class="step-content">
          <h3>Clamp onto any desk edge</h3>
          <p>Open the steel clamp and slide it over your desk edge — works on desks 1" to 3" thick. Tighten the knob until snug.</p>
          <div class="step-tip">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <circle cx="7" cy="7" r="6" fill="#E8924A"/>
              <text x="5" y="11" font-size="9" fill="white" font-weight="bold">!</text>
            </svg>
            Works on standing desks too
          </div>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="step reveal-step" data-step="2">
        <div class="step-icon-wrap">
          <div class="step-number">02</div>
          <div class="step-icon">
            <svg viewBox="0 0 80 80" fill="none">
              <circle cx="40" cy="40" r="38" fill="#F5E6D3" stroke="#E8924A" stroke-width="2"/>
              <!-- Bucket lowering in -->
              <path d="M28 24 C26 20 34 16 40 16 C46 16 54 20 52 24 L56 56 C56 62 50 66 40 66 C30 66 24 62 24 56 Z" fill="#D4A870"/>
              <ellipse cx="40" cy="24" rx="14" ry="4" fill="#E8B880"/>
              <!-- Drop arrows -->
              <path d="M40 6 L40 12" stroke="#E8924A" stroke-width="2.5" stroke-linecap="round"/>
              <polygon points="40,15 37,10 43,10" fill="#E8924A"/>
            </svg>
          </div>
        </div>
        <div class="step-content">
          <h3>Hang the bucket</h3>
          <p>Hook the bucket onto the clamp's support bars. The rattan basket drops right into place — zero tools, zero hardware.</p>
          <div class="step-tip">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <circle cx="7" cy="7" r="6" fill="#E8924A"/>
              <text x="5" y="11" font-size="9" fill="white" font-weight="bold">!</text>
            </svg>
            Adjustable depth — two positions
          </div>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="step reveal-step" data-step="3">
        <div class="step-icon-wrap">
          <div class="step-number">03</div>
          <div class="step-icon">
            <svg viewBox="0 0 80 80" fill="none">
              <circle cx="40" cy="40" r="38" fill="#F5E6D3" stroke="#E8924A" stroke-width="2"/>
              <!-- Cushion drop in -->
              <path d="M28 30 C26 26 34 22 40 22 C46 22 54 26 52 30 L56 60 C56 65 50 68 40 68 C30 68 24 65 24 60 Z" fill="#D4A870"/>
              <ellipse cx="40" cy="57" rx="14" ry="7" fill="#FAE8D0"/>
              <!-- Heart -->
              <path d="M36 43 C36 40 40 38 40 40 C40 38 44 40 44 43 C44 47 40 50 40 50 C40 50 36 47 36 43Z" fill="#E8924A"/>
            </svg>
          </div>
        </div>
        <div class="step-content">
          <h3>Drop in the cushion &amp; let your cat discover it</h3>
          <p>Place the memory foam insert inside. Most cats investigate immediately — spritz with catnip spray to speed up adoption.</p>
          <div class="step-tip">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <circle cx="7" cy="7" r="6" fill="#E8924A"/>
              <text x="5" y="11" font-size="9" fill="white" font-weight="bold">!</text>
            </svg>
            Catnip spray included free
          </div>
        </div>
      </div>
    </div>

    <!-- Time badge -->
    <div class="hiw-time-badge reveal-up">
      <div class="time-badge-inner">
        <div class="time-number" data-count-to="60">0</div>
        <div class="time-label">seconds to set up</div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{ "name": "How It Works", "settings": [] }
{% endschema %}
