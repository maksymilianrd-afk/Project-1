<section class="product-showcase" id="features">
  <div class="showcase-inner">
    <div class="showcase-visual">
      <div class="product-3d-card" id="product3d">
        <!-- Product illustration -->
        <div class="product-badge-new">New</div>
        <svg class="product-svg" viewBox="0 0 360 400" fill="none">
          <!-- Desk edge top -->
          <rect x="20" y="30" width="320" height="24" rx="5" fill="#3D2B1A"/>
          <rect x="20" y="30" width="320" height="7" rx="4" fill="#5C3D22"/>
          <!-- Clamp -->
          <rect x="148" y="18" width="64" height="18" rx="4" fill="#8B6340"/>
          <rect x="152" y="10" width="56" height="12" rx="3" fill="#A07850"/>
          <circle cx="162" cy="16" r="3" fill="#5C3D22"/>
          <circle cx="198" cy="16" r="3" fill="#5C3D22"/>
          <!-- Rods -->
          <rect x="162" y="52" width="9" height="30" rx="3" fill="#8B6340"/>
          <rect x="189" y="52" width="9" height="30" rx="3" fill="#8B6340"/>
          <!-- Bucket outer -->
          <path d="M110 80 C108 76 118 70 180 70 C242 70 252 76 250 80 L262 290 C262 306 244 320 180 320 C116 320 98 306 98 290 Z" fill="#D4A870"/>
          <!-- Bucket shading -->
          <path d="M118 84 C116 80 124 76 180 76 C236 76 244 80 242 84 L252 288 C252 298 238 310 180 310 C122 310 108 298 108 288 Z" fill="#C49060"/>
          <!-- Horizontal weave lines -->
          <path d="M112 130 Q180 122 248 130" stroke="#B87D4A" stroke-width="2" fill="none" opacity="0.5"/>
          <path d="M106 175 Q180 167 254 175" stroke="#B87D4A" stroke-width="2" fill="none" opacity="0.5"/>
          <path d="M102 220 Q180 212 258 220" stroke="#B87D4A" stroke-width="2" fill="none" opacity="0.5"/>
          <path d="M100 265 Q180 257 260 265" stroke="#B87D4A" stroke-width="2" fill="none" opacity="0.4"/>
          <!-- Vertical weave texture -->
          <line x1="140" y1="80" x2="132" y2="312" stroke="#B87D4A" stroke-width="1" opacity="0.3"/>
          <line x1="160" y1="76" x2="154" y2="314" stroke="#B87D4A" stroke-width="1" opacity="0.3"/>
          <line x1="180" y1="74" x2="180" y2="316" stroke="#B87D4A" stroke-width="1" opacity="0.3"/>
          <line x1="200" y1="76" x2="206" y2="314" stroke="#B87D4A" stroke-width="1" opacity="0.3"/>
          <line x1="220" y1="80" x2="228" y2="312" stroke="#B87D4A" stroke-width="1" opacity="0.3"/>
          <!-- Rim -->
          <ellipse cx="180" cy="78" rx="72" ry="11" fill="#E8B880"/>
          <!-- Interior cushion -->
          <ellipse cx="180" cy="296" rx="62" ry="20" fill="#F5E0C4"/>
          <ellipse cx="180" cy="292" rx="60" ry="18" fill="#FAE8D0"/>
          <!-- Sleeping cat silhouette inside -->
          <ellipse cx="175" cy="270" rx="52" ry="30" fill="#C4956A" opacity="0.9"/>
          <circle cx="148" cy="252" r="20" fill="#C4956A"/>
          <polygon points="136,236 130,220 144,234" fill="#C4956A"/>
          <polygon points="160,234 166,220 154,232" fill="#C4956A"/>
          <!-- Zzz -->
          <text x="175" y="232" font-family="serif" font-size="14" fill="#E8924A" opacity="0.8">z z Z</text>
          <!-- Bucket bottom -->
          <ellipse cx="180" cy="312" rx="80" ry="12" fill="#B87D4A" opacity="0.4"/>

          <!-- Measurement callouts -->
          <line x1="260" y1="78" x2="280" y2="78" stroke="#E8924A" stroke-width="1.5" stroke-dasharray="4,3"/>
          <line x1="266" y1="316" x2="280" y2="316" stroke="#E8924A" stroke-width="1.5" stroke-dasharray="4,3"/>
          <line x1="280" y1="78" x2="280" y2="316" stroke="#E8924A" stroke-width="1.5"/>
          <text x="286" y="200" font-family="DM Sans, sans-serif" font-size="11" fill="#E8924A">12"</text>
        </svg>
        <div class="product-shine"></div>
      </div>

      <!-- Color swatches -->
      <div class="color-selector">
        <span class="color-label">Color</span>
        <div class="swatches">
          <button class="swatch active" style="background:#D4A870" data-color="Sahara Tan" aria-label="Sahara Tan"></button>
          <button class="swatch" style="background:#5C3D22" data-color="Walnut Brown" aria-label="Walnut Brown"></button>
          <button class="swatch" style="background:#2D4A3E" data-color="Forest Green" aria-label="Forest Green"></button>
          <button class="swatch" style="background:#1A1A2E" data-color="Midnight" aria-label="Midnight"></button>
        </div>
        <span class="color-name" id="color-name">Sahara Tan</span>
      </div>
    </div>

    <div class="showcase-info">
      <div class="section-label reveal-up">— The DeskPaws Bucket</div>
      <h2 class="section-heading reveal-up" style="--delay:0.05s">
        Engineered for<br>
        <em>cat comfort.</em><br>
        Designed for your desk.
      </h2>
      <p class="section-body reveal-up" style="--delay:0.1s">
        Crafted from woven rattan with a memory foam insert, the DeskPaws bucket gives your cat a cozy perch right at your side — securely clamped to any desk edge up to 3 inches thick.
      </p>

      <div class="spec-grid reveal-up" style="--delay:0.15s">
        <div class="spec-item">
          <div class="spec-icon">⚖️</div>
          <div class="spec-label">Capacity</div>
          <div class="spec-value">Up to 12 lbs</div>
        </div>
        <div class="spec-item">
          <div class="spec-icon">📐</div>
          <div class="spec-label">Interior</div>
          <div class="spec-value">12" × 12" × 8"</div>
        </div>
        <div class="spec-item">
          <div class="spec-icon">🗜️</div>
          <div class="spec-label">Desk Fit</div>
          <div class="spec-value">1" – 3" thick</div>
        </div>
        <div class="spec-item">
          <div class="spec-icon">✨</div>
          <div class="spec-label">Material</div>
          <div class="spec-value">Rattan + Memory Foam</div>
        </div>
      </div>

      <div class="feature-checklist reveal-up" style="--delay:0.2s">
        {% assign features = "No tools needed — 60-second setup,Non-slip silicone desk protectors,Washable memory foam cushion insert,360° ventilation for airflow,Tested to 3× max rated weight" | split: "," %}
        {% for feat in features %}
          <div class="check-item">
            <svg class="check-icon" width="20" height="20" viewBox="0 0 20 20" fill="none">
              <circle cx="10" cy="10" r="9" fill="#E8924A" fill-opacity="0.15"/>
              <path d="M6 10l3 3 5-5" stroke="#E8924A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {{ feat }}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Product Showcase", "settings": [] }
{% endschema %}
