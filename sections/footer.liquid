<footer class="site-footer" id="footer">
  <div class="footer-wave">
    <svg viewBox="0 0 1440 80" preserveAspectRatio="none" fill="none">
      <path d="M0 40 C240 80 480 0 720 40 C960 80 1200 0 1440 40 L1440 80 L0 80 Z" fill="#2D1B0E"/>
    </svg>
  </div>

  <div class="footer-inner">
    <div class="footer-top">
      <!-- Brand -->
      <div class="footer-brand">
        <a href="/" class="logo logo--footer">
          {% if settings.logo %}
            {{ settings.logo | image_url: width: settings.logo_width | image_tag:
                class: 'logo-image logo-image--footer',
                alt: settings.logo.alt | default: shop.name,
                width: settings.logo_width,
                height: settings.logo_width | divided_by: settings.logo.aspect_ratio | round
            }}
          {% else %}
            <span class="logo-text">{{ shop.name }}</span>
          {% endif %}
        </a>
        <p class="footer-tagline">Making WFH better,<br>one cat nap at a time.</p>
        <div class="social-links">
          <a href="#" class="social-link" aria-label="Instagram">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <rect x="2" y="2" width="16" height="16" rx="4" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="10" cy="10" r="4" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="15" cy="5" r="1" fill="currentColor"/>
            </svg>
          </a>
          <a href="#" class="social-link" aria-label="TikTok">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M13 3a4 4 0 004 4v3a7 7 0 01-4-1.2V15a5 5 0 11-5-5v3a2 2 0 102 2V3h3z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a href="#" class="social-link" aria-label="Twitter/X">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M3 3l14 14M3 17L17 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Links -->
      <div class="footer-links-group">
        <h4>Product</h4>
        <ul>
          <li><a href="#features">Features</a></li>
          <li><a href="#how-it-works">How It Works</a></li>
          <li><a href="#reviews">Reviews</a></li>
          <li><a href="#buy">Buy Now</a></li>
        </ul>
      </div>
      <div class="footer-links-group">
        <h4>Support</h4>
        <ul>
          <li><a href="#">FAQ</a></li>
          <li><a href="#">Shipping Info</a></li>
          <li><a href="#">Returns & Refunds</a></li>
          <li><a href="#">Contact Us</a></li>
        </ul>
      </div>

      <!-- Newsletter -->
      <div class="footer-newsletter">
        <h4>Get cat content &amp; offers</h4>
        <p>Join 18,000+ cat parents. No spam — just paws.</p>
        <form class="newsletter-form" id="newsletter-form">
          <input type="email" placeholder="your@email.com" required aria-label="Email address">
          <button type="submit">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
              <path d="M3 9h12M9 3l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </form>
        <div class="newsletter-success" id="newsletter-success">
          🐾 You're in! Check your inbox.
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; 2026 DeskPaws. All rights reserved.</p>
      <div class="footer-legal">
        <a href="#">Privacy Policy</a>
        <a href="#">Terms of Service</a>
        <a href="#">Accessibility</a>
      </div>
      <div class="footer-payment">
        <span title="Visa">VISA</span>
        <span title="Mastercard">MC</span>
        <span title="PayPal">PP</span>
        <span title="Apple Pay">⌘Pay</span>
        <span title="Google Pay">G Pay</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{ "name": "Footer", "settings": [] }
{% endschema %}
