<section class="hero" id="hero">
  <!-- Background gradient orbs -->
  <div class="hero-orb hero-orb--1"></div>
  <div class="hero-orb hero-orb--2"></div>
  <div class="hero-orb hero-orb--3"></div>

  <!-- Directional atmosphere glow — bottom-left → upper-right toward basket -->
  <div class="hero-dir-glow" aria-hidden="true"></div>

  <!-- Atmospheric grain layer — ultra-subtle luxury texture -->
  <div class="hero-grain" aria-hidden="true"></div>

  <!-- Two-column split: text left, image right -->
  <div class="hero-split">
    <div class="hero-inner">
      <div class="hero-text">
        <div class="hero-badge reveal-up">
          <span class="badge-dot"></span>
          Now available — free shipping worldwide
        </div>
        <h1 class="hero-heading reveal-up" style="--delay:0.1s">
          Your Cat's New<br>
          <em>Favorite Desk</em><br>
          <span class="heading-accent">Companion.</span>
        </h1>
        <p class="hero-sub reveal-up" style="--delay:0.2s">
          The clip-on desk bucket that lets your cat sleep right beside you — no floor, no chair wars. Just pure desk-level bliss.
        </p>
        <div class="hero-actions reveal-up" style="--delay:0.3s">
          <a href="#buy" class="btn btn--primary">
            <span>Claim Your Bucket</span>
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
              <path d="M3 9h12M9 3l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a href="#how-it-works" class="btn btn--ghost">See how it works</a>
        </div>
        <div class="hero-social-proof reveal-up" style="--delay:0.4s">
          <div class="proof-avatars">
            <div class="proof-avatar" style="background:#E8924A">🐱</div>
            <div class="proof-avatar" style="background:#C4956A">😸</div>
            <div class="proof-avatar" style="background:#A07040">🐈</div>
            <div class="proof-avatar" style="background:#8B5E3C">😺</div>
          </div>
          <div class="proof-text">
            <div class="proof-stars">★★★★★</div>
            <span>Loved by <strong>2,400+</strong> cat parents</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Luxury ribbon — four organic layers, cream/amber tones, ultra-soft edges -->
    <svg class="hero-ribbon" viewBox="0 0 1000 600" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <filter id="hero-ribbon-blur" x="-60%" y="-60%" width="220%" height="220%">
          <feGaussianBlur stdDeviation="34"/>
        </filter>
        <filter id="hero-ribbon-blur-deep" x="-80%" y="-80%" width="260%" height="260%">
          <feGaussianBlur stdDeviation="52"/>
        </filter>
      </defs>
      <!-- Deep wash — widest, most diffuse, directional sweep from lower-left -->
      <path
        d="M-200,530 C20,500 240,460 510,428 C730,400 920,372 1250,348"
        fill="none"
        stroke="rgba(245,224,196,0.15)"
        stroke-width="230"
        stroke-linecap="round"
        filter="url(#hero-ribbon-blur-deep)"
      />
      <!-- Primary ribbon — warm sand, lower-left toward basket -->
      <path
        d="M-120,455 C60,432 230,406 460,388 C650,373 820,350 1120,330"
        fill="none"
        stroke="rgba(196,149,106,0.20)"
        stroke-width="130"
        stroke-linecap="round"
        filter="url(#hero-ribbon-blur)"
      />
      <!-- Secondary wisp — amber tint, slightly above -->
      <path
        d="M-80,388 C80,368 240,346 450,334 C640,323 820,304 1120,288"
        fill="none"
        stroke="rgba(232,146,74,0.07)"
        stroke-width="70"
        stroke-linecap="round"
        filter="url(#hero-ribbon-blur)"
      />
      <!-- Elegant S-curve accent — organic luxury shape through center -->
      <path
        d="M-60,490 C80,468 200,436 380,402 C540,371 680,322 860,308 C980,298 1080,305 1200,295"
        fill="none"
        stroke="rgba(225,175,115,0.09)"
        stroke-width="55"
        stroke-linecap="round"
        filter="url(#hero-ribbon-blur)"
      />
    </svg>

    <!-- Micro-anchors — glow dots + hearts flooding the full hero -->
    <div class="hero-sparkles" aria-hidden="true">
      <!-- Original center cluster -->
      <span class="sparkle sparkle-1"></span>
      <span class="sparkle sparkle-2"></span>
      <span class="sparkle sparkle-3"></span>
      <span class="sparkle sparkle-4"></span>
      <span class="sparkle sparkle-5"></span>
      <span class="sparkle-heart sh-1">♥</span>
      <span class="sparkle-heart sh-2">♥</span>
      <span class="sparkle-heart sh-3">♥</span>
      <!-- Left column (near hero text) -->
      <span class="sparkle" style="top:11%;left:7%;animation:sparklePulse 4.2s ease-in-out infinite -0.5s;width:4px;height:4px"></span>
      <span class="sparkle" style="top:27%;left:14%;animation:sparklePulse 6.1s ease-in-out infinite -1.3s;width:6px;height:6px"></span>
      <span class="sparkle" style="top:44%;left:5%;animation:sparklePulse 5.3s ease-in-out infinite -2.1s"></span>
      <span class="sparkle" style="top:64%;left:20%;animation:sparklePulse 7.2s ease-in-out infinite -0.9s;width:7px;height:7px"></span>
      <span class="sparkle" style="top:80%;left:11%;animation:sparklePulse 5.7s ease-in-out infinite -3.2s"></span>
      <span class="sparkle-heart" style="top:19%;left:9%;animation-delay:-1.6s;font-size:0.42rem">♥</span>
      <span class="sparkle-heart" style="top:52%;left:24%;animation-delay:-3.1s;font-size:0.55rem">♥</span>
      <span class="sparkle-heart" style="top:76%;left:33%;animation-delay:-0.8s;font-size:0.38rem">♥</span>
      <!-- Upper band -->
      <span class="sparkle" style="top:7%;left:36%;animation:sparklePulse 5.9s ease-in-out infinite -1.7s;width:5px;height:5px"></span>
      <span class="sparkle" style="top:14%;left:62%;animation:sparklePulse 4.8s ease-in-out infinite -0.4s"></span>
      <span class="sparkle" style="top:4%;left:77%;animation:sparklePulse 6.6s ease-in-out infinite -2.6s;width:4px;height:4px"></span>
      <span class="sparkle" style="top:18%;left:88%;animation:sparklePulse 5.0s ease-in-out infinite -1.1s;width:6px;height:6px"></span>
      <span class="sparkle-heart" style="top:8%;left:55%;animation-delay:-2.4s;font-size:0.44rem">♥</span>
      <span class="sparkle-heart" style="top:12%;left:82%;animation-delay:-0.6s;font-size:0.5rem">♥</span>
      <!-- Right side (over scene) -->
      <span class="sparkle" style="top:32%;left:73%;animation:sparklePulse 5.4s ease-in-out infinite -1.9s;width:5px;height:5px"></span>
      <span class="sparkle" style="top:56%;left:86%;animation:sparklePulse 4.3s ease-in-out infinite -0.7s"></span>
      <span class="sparkle" style="top:71%;left:67%;animation:sparklePulse 6.8s ease-in-out infinite -3.6s;width:7px;height:7px"></span>
      <span class="sparkle" style="top:87%;left:83%;animation:sparklePulse 5.1s ease-in-out infinite -1.2s;width:4px;height:4px"></span>
      <span class="sparkle-heart" style="top:38%;left:80%;animation-delay:-1.2s;font-size:0.48rem">♥</span>
      <span class="sparkle-heart" style="top:66%;left:91%;animation-delay:-4.1s;font-size:0.4rem">♥</span>
      <span class="sparkle-heart" style="top:84%;left:58%;animation-delay:-0.4s;font-size:0.52rem">♥</span>
      <!-- Lower band -->
      <span class="sparkle" style="top:92%;left:30%;animation:sparklePulse 6.4s ease-in-out infinite -2.3s"></span>
      <span class="sparkle" style="top:89%;left:47%;animation:sparklePulse 4.7s ease-in-out infinite -1.4s;width:6px;height:6px"></span>
      <span class="sparkle" style="top:94%;left:70%;animation:sparklePulse 5.8s ease-in-out infinite -0.2s;width:3px;height:3px"></span>
      <span class="sparkle-heart" style="top:91%;left:42%;animation-delay:-2.9s;font-size:0.46rem">♥</span>
    </div>

    <!-- Center-seam blending — melts the column boundary -->
    <div class="hero-center-seam" aria-hidden="true"></div>

    <!-- Scene glow — outside hero-scene so it isn't clipped at the 50% boundary -->
    <div class="scene-glow" aria-hidden="true"></div>

    <!-- Foreground depth haze — creates front plane illusion -->
    <div class="hero-fore-haze" aria-hidden="true"></div>

    <!-- Hero image — absolutely fills the right half -->
    <div class="hero-scene" style="--hero-img-scale: {{ section.settings.hero_image_scale | default: 100 | divided_by: 100.0 }};">
      <!-- Subtle atmosphere behind basket (kept faint to avoid right-side tinting) -->
      <div class="scene-atmosphere"></div>
      {% assign _hero_src = section.settings.hero_image | image_url: width: 960 %}
      {% unless _hero_src %}
        {% assign _hero_src = 'https://cdn.shopify.com/s/files/1/0765/4788/3055/files/magnific_ONfoiDrynm.png?v=1779386614' %}
      {% endunless %}
      <div class="hero-scene-img-wrap">
        <div class="bucket-shadow-wrap">
          <div class="bucket-shadow bucket-shadow--ambient"></div>
          <div class="bucket-shadow bucket-shadow--mid"></div>
          <div class="bucket-shadow bucket-shadow--core"></div>
        </div>
        <img
          src="{{ _hero_src }}"
          alt="DeskPaws cat desk bed"
          class="hero-photo"
          loading="eager">
        <div class="zzz-container">
          <span class="zzz zzz-1">z</span>
          <span class="zzz zzz-2">z</span>
          <span class="zzz zzz-3">z</span>
          <span class="zzz zzz-4">z</span>
          <span class="zzz zzz-5">Z</span>
          <span class="zzz zzz-6">Z</span>
        </div>
        <div class="heart-container">
          <span class="heart heart-1">♥</span>
          <span class="heart heart-2">♥</span>
          <span class="heart heart-3">♥</span>
          <span class="heart heart-4">♥</span>
          <span class="heart heart-5">♥</span>
          <span class="heart heart-6">♥</span>
        </div>
      </div>
      <div class="scene-label scene-label--clip">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M4 2h8a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V3a1 1 0 011-1z" fill="#E8924A"/>
          <path d="M7 6v8M9 6v8" stroke="#E8924A" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        Universal desk clip
      </div>
      <div class="scene-label scene-label--size">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <circle cx="8" cy="8" r="6" stroke="#E8924A" stroke-width="1.5"/>
          <path d="M8 5v3l2 2" stroke="#E8924A" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        Fits cats up to 12 lbs
      </div>
      <div class="scene-label scene-label--wash">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M3 7c0-2.2 1.8-4 4-4h2c2.2 0 4 1.8 4 4v1c0 1.5-.8 2.8-2 3.5C9.5 12.5 8 13 8 13s-1.5-.5-3-1.5C3.8 10.8 3 9.5 3 8V7z" stroke="#E8924A" stroke-width="1.4" stroke-linejoin="round"/>
          <path d="M6 9.5c.5.3 1.3.5 2 .5s1.5-.2 2-.5" stroke="#E8924A" stroke-width="1.3" stroke-linecap="round"/>
        </svg>
        Machine washable
      </div>
    </div>
  </div>

  <!-- Feature bar — full width below the split -->
  <div class="hero-feature-bar reveal-up" style="--delay:0.5s">
    <div class="hero-feature-item">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M10 2C10 2 6 5 4 9c-1.2 2.5-.8 5.5 1.5 7 1.2.8 2.7 1 4 .6 1.3.4 2.8.2 4-.6C15.8 14.5 16.2 11.5 15 9c-2-4-5-7-5-7z" stroke="#8B6340" stroke-width="1.5" stroke-linejoin="round"/>
        <path d="M10 8v5M8 11c.6.8 1.4 1.2 2 1.2s1.4-.4 2-1.2" stroke="#8B6340" stroke-width="1.3" stroke-linecap="round"/>
      </svg>
      <div>
        <strong>Premium Materials</strong>
        <span>Safe, soft &amp; sustainable</span>
      </div>
    </div>
    <div class="hero-feature-item">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <ellipse cx="10" cy="13" rx="4" ry="3" stroke="#8B6340" stroke-width="1.4"/>
        <ellipse cx="5.8" cy="9" rx="1.3" ry="1.7" stroke="#8B6340" stroke-width="1.3"/>
        <ellipse cx="8.4" cy="7.2" rx="1.3" ry="1.7" stroke="#8B6340" stroke-width="1.3"/>
        <ellipse cx="11.6" cy="7.2" rx="1.3" ry="1.7" stroke="#8B6340" stroke-width="1.3"/>
        <ellipse cx="14.2" cy="9" rx="1.3" ry="1.7" stroke="#8B6340" stroke-width="1.3"/>
      </svg>
      <div>
        <strong>Cat Approved</strong>
        <span>Loved by cats, trusted by humans</span>
      </div>
    </div>
    <div class="hero-feature-item">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M10 16s-7-4.5-7-8.5C3 5 4.8 3 7 3c1.3 0 2.4.7 3 1.7C10.6 3.7 11.7 3 13 3c2.2 0 4 2 4 4.5C17 11.5 10 16 10 16z" stroke="#8B6340" stroke-width="1.5" stroke-linejoin="round"/>
      </svg>
      <div>
        <strong>Made with Love</strong>
        <span>Thoughtful designs for happy naps</span>
      </div>
    </div>
    <div class="hero-feature-item">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M10 2C10 2 6 5 4 9c-1.2 2.5-.8 5.5 1.5 7 1.2.8 2.7 1 4 .6 1.3.4 2.8.2 4-.6C15.8 14.5 16.2 11.5 15 9c-2-4-5-7-5-7z" stroke="#8B6340" stroke-width="1.5" stroke-linejoin="round"/>
        <path d="M10 7v4M8.5 9.5h3" stroke="#8B6340" stroke-width="1.3" stroke-linecap="round"/>
      </svg>
      <div>
        <strong>Designed for Comfort</strong>
