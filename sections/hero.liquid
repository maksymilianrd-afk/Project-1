    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-indicator">
    <span>scroll</span>
    <div class="scroll-line"><div class="scroll-dot"></div></div>
  </div>
</section>

<style>
  /* Layered product shadow — three planes for realism */
  .bucket-shadow-wrap {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 60px;
    pointer-events: none;
  }

  .bucket-shadow { position: absolute; border-radius: 50%; pointer-events: none; }

  /* Ambient — widest, barely-there, right-biased spread */
  .bucket-shadow--ambient {
    bottom: 2%;
    left: 50%;
    transform: translateX(-54%);
    width: 100%;
    height: 32px;
    background: radial-gradient(ellipse at 46% 55%, rgba(28,12,3,0.13) 0%, rgba(28,12,3,0.04) 62%, transparent 80%);
    filter: blur(28px);
    animation: shadowAmbient 6s ease-in-out infinite;
  }

  /* Mid — balanced tone, medium softness */
  .bucket-shadow--mid {
    bottom: 5%;
    left: 50%;
    transform: translateX(-50%);
    width: 66%;
    height: 22px;
    background: radial-gradient(ellipse at 47% 55%, rgba(35,17,5,0.40) 0%, rgba(35,17,5,0.12) 55%, transparent 74%);
    filter: blur(12px);
    animation: shadowMid 6s ease-in-out infinite;
  }

  /* Core contact — tightest, darkest, offset left to break symmetry */
  .bucket-shadow--core {
    bottom: 8%;
    left: 50%;
    transform: translateX(-46%);
    width: 40%;
    height: 12px;
    background: radial-gradient(ellipse at 53% 55%, rgba(18,8,1,0.75) 0%, rgba(18,8,1,0.28) 50%, transparent 68%);
    filter: blur(4px);
    animation: shadowCore 6s ease-in-out infinite;
  }

  @keyframes shadowCore {
    0%, 100% { transform: translateX(-46%) scaleX(1);    opacity: 0.92; }
    50%       { transform: translateX(-46%) scaleX(0.78); opacity: 0.52; }
  }
  @keyframes shadowMid {
    0%, 100% { transform: translateX(-50%) scaleX(1);    opacity: 1;    }
    50%       { transform: translateX(-50%) scaleX(0.85); opacity: 0.68; }
  }
  @keyframes shadowAmbient {
    0%, 100% { transform: translateX(-54%) scaleX(1);    opacity: 1;    }
    50%       { transform: translateX(-54%) scaleX(0.93); opacity: 0.76; }
  }

  /* Zzz sleep animation — originates at cat's mouth */
  .zzz-container { position: absolute; top: 40%; left: 33%; pointer-events: none; }
  .zzz {
    position: absolute;
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    color: #C4956A;
    opacity: 0;
    animation: floatZzz 4s ease-in-out infinite;
    text-shadow: 0 1px 4px rgba(196,149,106,0.35);
  }
  .zzz-1 { font-size: 0.75rem; animation-delay: 0s;    left: 0;    top: 0; }
  .zzz-2 { font-size: 0.9rem;  animation-delay: 0.65s; left: 8px;  top: -2px; }
  .zzz-3 { font-size: 1.1rem;  animation-delay: 1.3s;  left: 18px; top: -4px; }
  .zzz-4 { font-size: 1.35rem; animation-delay: 1.95s; left: 30px; top: -6px; }
  .zzz-5 { font-size: 1.65rem; animation-delay: 2.6s;  left: 44px; top: -8px; }
  .zzz-6 { font-size: 2rem;    animation-delay: 3.25s; left: 60px; top: -10px; }
  @keyframes floatZzz {
    0%   { opacity: 0; transform: translate(0,0) rotate(-8deg) scale(0.7); }
    20%  { opacity: 1; }
    70%  { opacity: 0.6; }
    100% { opacity: 0; transform: translate(16px,-52px) rotate(14deg) scale(1.1); }
  }

  /* Heart animation — near cat's head */
  .heart-container { position: absolute; top: 30%; left: 40%; pointer-events: none; }
  .heart {
    position: absolute;
    font-family: serif;
    opacity: 0;
    animation: floatHeart 3s ease-in-out infinite;
    filter: drop-shadow(0 1px 3px rgba(232,146,74,0.4));
  }
  .heart-1 { font-size: 0.7rem;  color: #E8924A; animation-delay: 0s;    left: 4px;  top: 0; }
  .heart-2 { font-size: 1rem;    color: #F5B272; animation-delay: 0.5s;  left: -6px; top: -4px; }
  .heart-3 { font-size: 0.65rem; color: #E8924A; animation-delay: 1s;    left: 16px; top: -2px; }
  .heart-4 { font-size: 1.2rem;  color: #F5B272; animation-delay: 1.5s;  left: -2px; top: 2px; }
  .heart-5 { font-size: 0.8rem;  color: #E8924A; animation-delay: 2s;    left: 12px; top: -6px; }
  .heart-6 { font-size: 0.55rem; color: #F5B272; animation-delay: 2.5s;  left: 22px; top: 0px; }
  @keyframes floatHeart {
    0%   { opacity: 0; transform: translate(0,0) scale(0.4) rotate(-8deg); }
    15%  { opacity: 1; transform: translate(-4px,-12px) scale(1.1) rotate(4deg); }
    60%  { opacity: 0.8; transform: translate(3px,-32px) scale(1) rotate(-3deg); }
    100% { opacity: 0; transform: translate(-2px,-56px) scale(0.6) rotate(10deg); }
  }
</style>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image",
      "info": "Recommended: at least 960px wide, transparent or light background."
    },
    {
      "type": "range",
      "id": "hero_image_scale",
      "label": "Image scale",
      "min": 80,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ]
}
{% endschema %}
