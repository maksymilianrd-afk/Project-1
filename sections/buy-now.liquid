<section class="buy-now" id="buy">
  <div class="buy-bg-pattern"></div>
  <div class="buy-inner">
    <div class="buy-left reveal-up">
      <div class="section-label" style="color:#E8924A">— Limited stock</div>
      <h2 class="section-heading" style="color:white">
        Give your cat<br>
        <em>the best seat</em><br>
        in the house.
      </h2>
      <p class="section-body" style="color:rgba(255,255,255,0.7)">
        Join 2,400+ cat parents who've made work-from-home infinitely more wholesome.
      </p>

      <!-- Trust badges -->
      <div class="trust-badges">
        <div class="trust-badge">
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
            <path d="M11 2L13.5 7.5H20L15 11.5L17 17.5L11 14L5 17.5L7 11.5L2 7.5H8.5L11 2Z" fill="#E8924A"/>
          </svg>
          <span>30-Day Guarantee</span>
        </div>
        <div class="trust-badge">
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
            <rect x="3" y="8" width="16" height="11" rx="2" stroke="#E8924A" stroke-width="1.5"/>
            <path d="M7 8V6a4 4 0 118 0v2" stroke="#E8924A" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <span>Secure Checkout</span>
        </div>
        <div class="trust-badge">
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
            <path d="M3 11h16M14 6l5 5-5 5" stroke="#E8924A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Free Worldwide Shipping</span>
        </div>
      </div>

      <!-- Press logos -->
      <div class="press-strip">
        <span class="press-label">As seen in</span>
        <div class="press-logos">
          <span class="press-logo">Wired</span>
          <span class="press-sep">·</span>
          <span class="press-logo">Product Hunt</span>
          <span class="press-sep">·</span>
          <span class="press-logo">TechCrunch</span>
          <span class="press-sep">·</span>
          <span class="press-logo">Cat Fancy</span>
        </div>
      </div>
    </div>

    <div class="buy-right reveal-scale">
      <div class="product-card">
        <div class="product-card-header">
          <!-- Mini product image -->
          <svg class="product-card-img" viewBox="0 0 200 200" fill="none">
            <circle cx="100" cy="100" r="90" fill="#F5E6D3"/>
            <!-- Mini desk bucket -->
            <rect x="30" y="30" width="140" height="12" rx="3" fill="#3D2B1A"/>
            <rect x="82" y="20" width="36" height="12" rx="3" fill="#8B6340"/>
            <rect x="88" y="40" width="5" height="18" rx="2" fill="#8B6340"/>
            <rect x="107" y="40" width="5" height="18" rx="2" fill="#8B6340"/>
            <path d="M65 56 C63 52 72 48 100 48 C128 48 137 52 135 56 L140 150 C140 160 130 168 100 168 C70 168 60 160 60 150 Z" fill="#D4A870"/>
            <ellipse cx="100" cy="58" rx="37" ry="8" fill="#E8B880"/>
            <ellipse cx="100" cy="156" rx="40" ry="10" fill="#F5E0C4"/>
            <!-- Sleeping cat in bucket -->
            <ellipse cx="96" cy="138" rx="32" ry="22" fill="#C4956A"/>
            <circle cx="76" cy="126" r="16" fill="#C4956A"/>
            <polygon points="66,112 60,98 74,110" fill="#C4956A"/>
            <polygon points="86,110 92,98 80,108" fill="#C4956A"/>
            <circle cx="72" cy="124" r="4" fill="#2D1B0E"/>
            <circle cx="80" cy="124" r="4" fill="#2D1B0E"/>
            <circle cx="73" cy="123" r="1.5" fill="white"/>
            <circle cx="81" cy="123" r="1.5" fill="white"/>
            <ellipse cx="76" cy="129" rx="3" ry="2" fill="#E8924A"/>
            <path d="M73 131 Q76 134 79 131" stroke="#C4956A" stroke-width="1.5" fill="none" stroke-linecap="round"/>
          </svg>

          <div class="product-card-title">
            <h3>The DeskPaws Bucket</h3>
            <div class="product-card-stars">★★★★★ <span>4.9 (2,418)</span></div>
          </div>
        </div>

        <div class="price-block">
          <div class="price-current">$89</div>
          <div class="price-original">$129</div>
          <div class="price-badge">Save $40</div>
        </div>

        <!-- Variant selector -->
        <div class="variant-section">
          <label class="variant-label">Color — <span id="selected-color-buy">Sahara Tan</span></label>
          <div class="variant-swatches">
            <button class="vswatch active" style="--c:#D4A870" data-color="Sahara Tan" aria-label="Sahara Tan">
              <span class="vswatch-inner"></span>
            </button>
            <button class="vswatch" style="--c:#5C3D22" data-color="Walnut Brown" aria-label="Walnut Brown">
              <span class="vswatch-inner"></span>
            </button>
            <button class="vswatch" style="--c:#2D4A3E" data-color="Forest Green" aria-label="Forest Green">
              <span class="vswatch-inner"></span>
            </button>
            <button class="vswatch" style="--c:#1A1A2E" data-color="Midnight" aria-label="Midnight">
              <span class="vswatch-inner"></span>
            </button>
          </div>
        </div>

        <!-- Quantity -->
        <div class="quantity-section">
          <label class="variant-label">Quantity</label>
          <div class="quantity-control">
            <button class="qty-btn" id="qty-minus">−</button>
            <span class="qty-display" id="qty-display">1</span>
            <button class="qty-btn" id="qty-plus">+</button>
          </div>
        </div>

        <button class="btn btn--buy btn--primary" id="add-to-cart-btn">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M6 2L3 6v14a2 2 0 002 2h10a2 2 0 002-2V6l-3-4zM3 6h14M13 10a3 3 0 01-6 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Add to Cart — $89
        </button>

        <button class="btn btn--buy-now">
          Buy Now — Instant Checkout
        </button>

        <div class="card-reassurance">
          <span>🚚 Free shipping · Est. delivery 3–5 days</span>
          <span>🔒 SSL encrypted checkout</span>
        </div>

        <!-- Stock urgency -->
        <div class="stock-bar-section">
          <div class="stock-label">
            <span class="stock-dot"></span>
            <strong>Only 14 left</strong> in Sahara Tan
          </div>
          <div class="stock-bar">
            <div class="stock-bar-fill" style="width:18%"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Buy Now", "settings": [] }
{% endschema %}
